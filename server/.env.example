# Copy this file to .env and fill in real values. Never commit .env.

# Required for the "Ask ViscoLoop" bot to answer with real AI (Claude).
# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Port the server listens on.
PORT=3000

# Optional. If set, moving a suggestion's status (or deleting one) requires
# this passcode via the "Unlock leadership controls" prompt. Leave unset
# during a small pilot to keep those actions open to everyone.
LEADERSHIP_PASSCODE=
